# ==========================================

# SERVER

# ==========================================

PORT=5000
NODE_ENV=development

# ==========================================

# DATABASE

# ==========================================

MONGO_URI=mongodb://localhost:27017/sports-ecommerce

# ==========================================

# FRONTEND

# ==========================================

FRONTEND_URL=http://localhost:5173

# ==========================================

# AUTHENTICATION

# ==========================================

JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=1h

# Cookie expiration in minutes

COOKIE_EXPIRES_IN=60

# ==========================================

# PASSWORD HASHING

# ==========================================

BCRYPT_ROUNDS=12

# ==========================================

# EMAIL / SMTP

# ==========================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=[your-email@example.com](mailto:your-email@example.com)
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=Sports Store [your-email@example.com](mailto:your-email@example.com)
